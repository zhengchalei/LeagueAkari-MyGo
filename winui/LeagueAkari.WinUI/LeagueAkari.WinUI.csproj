<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../desktop/resources/LA_ICON.ico</ApplicationIcon>
    <EnableMsixTooling>false</EnableMsixTooling>
    <RootNamespace>LeagueAkari.WinUI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>
 <ItemGroup><Content Include="../../desktop/resources/LA_ICON.ico" Link="LA_ICON.ico" CopyToOutputDirectory="PreserveNewest" /><Content Include="../../desktop/src/renderer-shared/components/match-card/map-images/*.png" Link="map-images/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Services/Locales/*.json" /></ItemGroup>
  <ItemGroup>
    <Content Include="../../desktop/src/renderer-shared/assets/ranked-icons/*.png" Link="ranked-icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../desktop/src/renderer-shared/assets/ranked-icons-large/*.png" Link="ranked-icons-large/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
